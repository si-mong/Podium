DEBUG=true

DATABASE_URL=postgresql+psycopg://podium:podium@localhost:5432/podium

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
# access 토큰 수명(분) / refresh 토큰 수명(일) = 로그인 유지 기간
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=14

UPLOAD_DIR=./uploads

OPENAI_API_KEY=
WHISPER_MODEL=large-v3
# STEP 3 를 학교 GPU 서버에 맡길 때만 채움 (학교 내부망 전용). 비우면 이 컴퓨터에서 실행.
# 예: STT_REMOTE_URL=http://10.198.138.104:18002
STT_REMOTE_URL=

# STEP 2 VLM (Gemini)
GEMINI_API_KEY=

# STEP 5 피드백 LLM (모델 비교용). provider 는 gemini 또는 openai.
# openai 로 바꾸면 위의 OPENAI_API_KEY 도 채워야 함. 바꾼 뒤 서버 재시작.
# 예: STEP5_PROVIDER=openai / STEP5_MODEL=gpt-4o
STEP5_PROVIDER=gemini
STEP5_MODEL=gemini-2.5-flash
