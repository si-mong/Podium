DEBUG=true

DATABASE_URL=postgresql+psycopg://podium:podium@localhost:5432/podium

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
# access 토큰 수명(분) / refresh 토큰 수명(일) = 로그인 유지 기간
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=14

UPLOAD_DIR=./uploads

OPENAI_API_KEY=
# STEP 3 STT 모델
#   hf:<모델 id>    : 이 컴퓨터에서 실행 (맥은 MPS, 그 외 CPU) — 기본값
#   modal:<모델 id> : Modal 서버리스 GPU 에서 실행 (backend/modal_stt.py 배포 + Modal 토큰 필요)
WHISPER_MODEL=hf:rearleg/SeloWhisper-ko-disfluency

# STEP 2 VLM (Gemini)
GEMINI_API_KEY=

# 허용할 프론트엔드 origin (쉼표 구분)
CORS_ORIGINS=http://localhost:3000,http://localhost:8001

# 구글 로그인 (Google Cloud 콘솔 → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID, 웹 애플리케이션)
#   승인된 리디렉션 URI: <API_PUBLIC_URL>/auth/google/callback  (로컬: http://localhost:8000/auth/google/callback)
# 비워 두면 구글 로그인 버튼이 비활성화되고, DEBUG=true 일 때만 개발용 이메일 로그인을 쓸 수 있다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
API_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
