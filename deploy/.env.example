# deploy/.env 로 복사해서 값을 채운다. (.env 는 git 에 올리지 않음)

# --- 도메인 / CORS ---
API_DOMAIN=api.example.com
CORS_ORIGINS=https://podium.vercel.app

# --- DB ---
# openssl rand -hex 24 로 생성
POSTGRES_PASSWORD=

# --- Auth ---
# openssl rand -hex 32 로 생성
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=14

# --- 외부 API ---
OPENAI_API_KEY=
GEMINI_API_KEY=
