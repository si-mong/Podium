# deploy/.env 로 복사해서 값을 채운다. (.env 는 git 에 올리지 않음)

# --- 도메인 / CORS ---
API_DOMAIN=api.example.com
CORS_ORIGINS=https://podium.vercel.app

# --- DB ---
# openssl rand -hex 24 로 생성
POSTGRES_PASSWORD=

# --- Auth ---
# openssl rand -hex 32 로 생성
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=14

# --- 외부 API ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- STEP 3 STT (Modal 서버리스 GPU) ---
# hf:<모델 id> 로 두면 서버 CPU 에서 실행 (5분 영상에 약 10분). modal: 이면 1분 안팎.
WHISPER_MODEL=modal:rearleg/SeloWhisper-ko-disfluency
# Modal 대시보드 → Settings → API Tokens 에서 발급
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- 구글 로그인 ---
# Google Cloud 콘솔의 승인된 리디렉션 URI 에 https://<API_DOMAIN>/auth/google/callback 을 등록
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
API_PUBLIC_URL=https://api.example.com
FRONTEND_URL=https://podium.vercel.app
